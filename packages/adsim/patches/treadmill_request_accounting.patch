+/**
+ * Waits for every worker to finish its outstanding requests and logs the
+ * request accounting. Exits the process with status 2 if the drain times out,
+ * because outstanding callbacks still reference the workers.
+ *
+ * @return Whether every scheduled request was submitted or dropped, and every
+ *         submitted request completed
+ */
+template <typename Service>
+bool drainAndLogRequestAccounting(
+    const std::vector<std::unique_ptr<Worker<Service>>> &workers,
+    const Scheduler &scheduler) {
+  const auto deadline = std::chrono::steady_clock::now() +
+      std::chrono::seconds(FLAGS_drain_timeout_seconds);
+  bool drain_complete = true;
+  for (const auto &worker : workers) {
+    if (!worker->waitUntilQuiescent(deadline)) {
+      drain_complete = false;
+      break;
+    }
+  }
+
+  uint64_t submitted = 0;
+  uint64_t success_completed = 0;
+  uint64_t exception_completed = 0;
+  uint64_t dropped = 0;
+  uint64_t in_flight = 0;
+  for (const auto &worker : workers) {
+    submitted += worker->getSubmittedRequests();
+    success_completed += worker->getSuccessCompletedRequests();
+    exception_completed += worker->getExceptionCompletedRequests();
+    dropped += worker->getDroppedRequests();
+    in_flight += worker->getInFlightRequests();
+  }
+  const uint64_t scheduled_enqueued = scheduler.getScheduledEnqueued();
+  const bool accounting_valid = drain_complete &&
+      scheduled_enqueued == submitted + dropped &&
+      submitted == success_completed + exception_completed + in_flight;
+
+  folly::dynamic accounting = folly::dynamic::object;
+  accounting["schema_version"] = 1;
+  accounting["scheduled_enqueued"] = static_cast<int64_t>(scheduled_enqueued);
+  accounting["submitted"] = static_cast<int64_t>(submitted);
+  accounting["success_completed"] = static_cast<int64_t>(success_completed);
+  accounting["exception_completed"] =
+      static_cast<int64_t>(exception_completed);
+  accounting["dropped"] = static_cast<int64_t>(dropped);
+  accounting["in_flight"] = static_cast<int64_t>(in_flight);
+  accounting["drain_complete"] = drain_complete;
+  accounting["accounting_valid"] = accounting_valid;
+
+  if (!drain_complete) {
+    LOG(ERROR) << "REQUEST_ACCOUNTING_JSON: " << folly::toJson(accounting);
+    google::FlushLogFiles(google::GLOG_INFO);
+    std::_Exit(2);
+  }
+  LOG(INFO) << "REQUEST_ACCOUNTING_JSON: " << folly::toJson(accounting);
+  return accounting_valid;
+}
