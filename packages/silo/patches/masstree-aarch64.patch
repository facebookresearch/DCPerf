 inline void relax_fence() {
+#if defined(__aarch64__)
+    asm volatile("yield" : : : "memory"); // spin-loop hint, cf. x86 "pause"
+#else
     asm volatile("pause" : : : "memory"); // equivalent to "rep; nop"
+#endif
 }
 
