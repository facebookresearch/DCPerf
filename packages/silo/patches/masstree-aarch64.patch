 inline uint64_t read_pmc(uint32_t ecx) {
+#if defined(__aarch64__)
+    // No userspace-readable performance counter on AArch64; callers in
+    // this tree (none in the dbtest build) must not rely on the value.
+    (void) ecx;
+    return 0;
+#else
     uint32_t a, d;
     __asm __volatile("rdpmc" : "=a"(a), "=d"(d) : "c"(ecx));
     return ((uint64_t)a) | (((uint64_t)d) << 32);
+#endif
 }
 
 inline uint64_t read_tsc(void)
 {
+#if defined(__aarch64__)
+    uint64_t v;
+    __asm volatile("mrs %0, cntvct_el0" : "=r" (v));
+    return v;
+#else
     uint32_t low, high;
     asm volatile("rdtsc" : "=a" (low), "=d" (high));
     return ((uint64_t)low) | (((uint64_t)high) << 32);
+#endif
 }
 
