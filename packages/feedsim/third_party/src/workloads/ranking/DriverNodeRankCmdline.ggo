package "DriverNodeRank"
version "0.1"
usage "DriverNodeRank [options]"
description "Test driving node for search"

args "-c cc --show-required -C --default-optional -l"

option "verbose" v "Verbosity. Repeat for more verbose." multiple
option "quiet" - "Disable log messages."

option "threads" - "Number of threads to spawn." int default="1"
option "server" - "Address of parent node hostname[:port]." string
option "connections" - "Connections to establish per thread." int default="1"
option "depth" - "Maximum depth to pipeline requests per thread." int default="1"
option "qps" - "Rate to send requests at. 0 means send as fast as it can." float default="0"

option "monitor_port" - "Port to run monitoring server on." int default="7777"

option "affinity" - "Set distinct CPU affinity for threads, round-robin"

# Phase 7: Client-side DLRM feature generation options
option "client_side_features" - "Generate DLRM features on client side and send via RankingRequest" flag off
option "client_dlrm_batch_size" - "Batch size for client-side feature generation" int default="256"
option "client_dlrm_inferences" - "Number of DLRM inferences per request" int default="64"
option "client_feature_seed" - "Seed for client feature generation. Default 42 for deterministic. Use -1 for random." long default="42"
option "client_num_dense_features" - "Number of dense features per sample" int default="13"
option "client_num_sparse_features" - "Number of sparse features per sample" int default="26"

# Phase 3 (Plan): Silesia corpus story options
option "silesia_dir" - "Path to Silesia corpus directory. When specified, stories from the corpus are included in each request." string typestr="directory" optional
option "story_size_min" - "Minimum story snippet size in bytes." int default="1024"
option "story_size_max" - "Maximum story snippet size in bytes." int default="4096"
option "stories_per_request" - "Number of story snippets to include per request." int default="10"

# Phase 4 (Plan): Request size distribution matching production
option "req_size_dist" - "Path to JSON file with request size percentile distribution. Pads each request to a sampled size matching the distribution." string typestr="json_file" optional

# Phase 6: Session orchestration. When --rpc_dist_json is given, the
# driver issues per-session pipelines (createAndPrimeSession ->
# getStoriesUncompressed + streamData * N -> getAllStories) instead of
# single fire-and-forget requests. The same JSON file LeafNodeRank uses
# for outbound shaping supplies the inbound percentile distributions.
option "rpc_dist_json" - "Path to rpc_dist.json. When provided, the driver runs in session mode and shapes inbound payload sizes from the production percentile distribution." string typestr="json_file" optional
option "streamdata_per_session" - "Number of streamData calls issued in parallel per session (matches prod ~2x ratio). Use 0 to randomize uniformly in [1,3]." int default="2"
option "stream_ifr_probability" - "Probability of issuing a streamIfrPriorityRanking call per session (production ratio ~0.045)." float default="0.045"
